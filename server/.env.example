# Copy to .env and fill in. Names only here; never commit real values.

# Backend
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Database (inside docker compose, DB_HOST is the service name "mysql")
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
TEST_DB_NAME=
MYSQL_ROOT_PASSWORD=

# Login: at least 32 random characters, for example: openssl rand -hex 32
JWT_SECRET=

# Optional: limit for login and register tries per client address (defaults: 20 per 15 minutes)
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Frontend (build step 6)
VITE_API_BASE_URL=http://localhost:8080
